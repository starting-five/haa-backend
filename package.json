    "version:build-tag": "node scripts/print-build-tag.cjs",
    "db:reset": "tsx src/scripts/reset.ts",
    "lint": "eslint src",
    "format": "prettier --write src",
    "db:approve-lawyer": "tsx src/scripts/approve-lawyer.ts",
    "validate:migration": "node scripts/validate-migration.cjs",
    "test:migration-safety": "node scripts/test-migration-validator.cjs",
    "test:data-preservation": "tsx src/scripts/test-data-preservation.ts",
    "test:agreement-concurrency": "tsx src/scripts/test-agreement-concurrency.ts",
    "test:agreement-locale": "tsx src/scripts/test-agreement-locale.ts",
    "test:dev-auth": "tsx src/scripts/test-dev-auth.ts",
    "test:claimant-identity": "tsx src/scripts/test-claimant-identity.ts",
    "test:registration-status": "tsx src/scripts/test-registration-status.ts",
    "test:start-without-accident": "tsx src/scripts/test-start-without-accident.ts",
    "test:stranded-claimant": "tsx src/scripts/test-stranded-claimant.ts",
    "test:ambassador-people": "tsx src/scripts/test-ambassador-people.ts",
    "docusign:check": "tsx src/scripts/docusign-check.ts",
    "test:isolation": "tsx src/scripts/test-patient-isolation.ts",
    "test:version": "tsx src/scripts/test-version.ts",
    "test:lawyer-review-view": "tsx src/scripts/test-lawyer-review-view.ts",
    "test:lawyer-review": "tsx src/scripts/test-lawyer-review.ts",
    "test:lawyer-retainer": "tsx src/scripts/test-lawyer-retainer.ts",
    "test:provider-matches": "tsx src/scripts/test-provider-matches.ts",
    "test:case-summary": "tsx src/scripts/test-case-summary.ts",
    "test:case-summary-route": "tsx src/scripts/test-case-summary-route.ts",
